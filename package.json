{
  "name": "portfolio_new",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "css": "tailwindcss -i ./src/input.css -o ./src/output.css --watch",
    "build": "tailwindcss -i ./src/input.css -o ./src/output.css --minify",
    "serve": "live-server --port=5500",
    "dev": "concurrently \"npm run css\" \"npm run serve\""
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "live-server": "^1.2.2"
  }
}
